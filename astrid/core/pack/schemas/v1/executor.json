{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "executor.json",
  "type": "object",
  "description": "Pack-author schema for executor manifests. Updated to match what the runtime registry (astrid/core/executor/schema.py) actually consumes — the prior schema required a `runtime` block that nothing read and rejected the `command`/`inputs`/`outputs` fields every real executor uses.",
  "required": ["schema_version", "id", "name", "version"],
  "properties": {
    "schema_version": {"type": "integer"},
    "id": {"$ref": "_defs.json#/definitions/qualified_id"},
    "name": {"type": "string"},
    "version": {"$ref": "_defs.json#/definitions/version_string"},
    "description": {"type": "string"},
    "short_description": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "kind": {"type": "string", "enum": ["built_in", "external"]},
    "runtime": {
      "oneOf": [
        {"$ref": "_defs.json#/definitions/runtime_python_cli"},
        {"$ref": "_defs.json#/definitions/runtime_python"},
        {"$ref": "_defs.json#/definitions/runtime_command"}
      ]
    },
    "command": {
      "type": "object",
      "properties": {
        "argv": {"type": "array", "items": {"type": "string"}},
        "cwd": {"type": "string"},
        "env": {"type": "object"},
        "input_args": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input": {"type": "string"},
              "flag": {"type": ["string", "null"]},
              "repeatable": {"type": "boolean"},
              "optional": {"type": "boolean"},
              "before": {"type": ["string", "null"]}
            },
            "required": ["input"],
            "additionalProperties": false
          }
        }
      },
      "required": ["argv"],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "required": {"type": "boolean"},
          "default": {},
          "description": {"type": "string"},
          "placeholder": {"type": "string"},
          "artifact_type": {"type": ["string", "null"]}
        },
        "required": ["name"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "mode": {"type": "string"},
          "path_template": {"type": "string"},
          "extension": {"type": "string"},
          "placeholder": {"type": "string"},
          "description": {"type": "string"},
          "artifact_type": {"type": ["string", "null"]}
        },
        "required": ["name"]
      }
    },
    "cache": {"type": "object"},
    "conditions": {"type": "array"},
    "graph": {"type": "object"},
    "clip_kinds_supported": {"type": "array"},
    "pipeline_requirements": {"type": "array"},
    "scoped_configs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
      "description": "Scope keys declared by this executor (resolved at runner dispatch)."
    },
    "isolation": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["subprocess"]},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "binaries": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "boolean"},
        "env_passthrough": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        }
      },
      "additionalProperties": true
    },
    "external_runtime": {"type": "object"},
    "docs": {
      "type": "object",
      "properties": {
        "stage": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
