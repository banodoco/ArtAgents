{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestrator.json",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "runtime"],
  "properties": {
    "schema_version": {"type": "integer"},
    "id": {"$ref": "_defs.json#/definitions/qualified_id"},
    "name": {"type": "string"},
    "version": {"$ref": "_defs.json#/definitions/version_string"},
    "kind": {"type": "string", "enum": ["built_in", "external"]},
    "short_description": {"type": "string"},
    "description": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "runtime": {
      "oneOf": [
        {"$ref": "_defs.json#/definitions/runtime_python_cli"},
        {"$ref": "_defs.json#/definitions/runtime_python"},
        {"$ref": "_defs.json#/definitions/runtime_command"},
        {"$ref": "_defs.json#/definitions/runtime_command_legacy"}
      ]
    },
    "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "child_executors": {"type": "array", "items": {"type": "string"}},
    "child_orchestrators": {"type": "array", "items": {"type": "string"}},
    "cache": {"type": "object", "additionalProperties": true},
    "scoped_configs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
      "description": "Scope keys declared by this orchestrator (resolved at runner dispatch)."
    },
    "isolation": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["in_process", "subprocess"]},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "binaries": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "boolean"},
        "env_passthrough": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        }
      },
      "additionalProperties": true
    },
    "docs": {
      "type": "object",
      "properties": {
        "stage": {"type": "string"}
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
