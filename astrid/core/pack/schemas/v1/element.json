{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "element.json",
  "type": "object",
  "required": ["schema_version", "id", "kind", "pack_id", "metadata", "schema", "defaults", "dependencies"],
  "properties": {
    "schema_version": {"type": "integer"},
    "id": {"type": "string"},
    "kind": {"type": "string", "enum": ["effect", "animation", "transition"]},
    "pack_id": {"$ref": "_defs.json#/definitions/pack_id"},
    "metadata": {
      "type": "object",
      "properties": {
        "description": {"type": "string"},
        "label": {"type": "string"},
        "name": {"type": "string"},
        "whenToUse": {"type": "string"}
      },
      "additionalProperties": true
    },
    "schema": {
      "type": "object"
    },
    "defaults": {
      "type": "object"
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "js_packages": {"type": "array", "items": {"type": "string"}},
        "python_requirements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "docs": {
      "type": "object"
    },
    "description": {"type": "string"},
    "short_description": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "required": {"type": "boolean"},
          "default": {},
          "description": {"type": "string"},
          "placeholder": {"type": "string"},
          "artifact_type": {"type": ["string", "null"]}
        },
        "required": ["name"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "type": {"type": "string"},
          "mode": {"type": "string"},
          "path_template": {"type": "string"},
          "extension": {"type": "string"},
          "placeholder": {"type": "string"},
          "description": {"type": "string"},
          "artifact_type": {"type": ["string", "null"]}
        },
        "required": ["name"]
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "adapter": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
