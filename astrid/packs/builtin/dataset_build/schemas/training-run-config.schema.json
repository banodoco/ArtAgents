{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrid.builtin-training/schemas/training-run-config.schema.json",
  "title": "Training Run Config",
  "description": "Configuration for builtin.training_run. Schema version 1, ai-toolkit-ltx trainer, RunPod compute backend.",
  "type": "object",
  "required": ["schema_version", "trainer_id", "manifest_path", "compute", "base_model", "lora_config", "output"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "trainer_id": {
      "type": "string",
      "enum": ["ai-toolkit-ltx"],
      "description": "Trainer adapter id."
    },
    "manifest_path": {
      "type": "string",
      "description": "Path to the canonical or ai-toolkit adapter manifest."
    },
    "vocabulary_path": {
      "type": "string",
      "description": "Path to vocabulary YAML for caption templates."
    },
    "compute": {
      "type": "object",
      "required": ["backend", "max_gpu_hours", "max_runpod_spend_usd"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "const": "runpod"
        },
        "gpu_type": {
          "type": "string",
          "default": "NVIDIA RTX 6000 Ada Generation",
          "description": "GPU type to provision."
        },
        "container_disk_gb": {
          "type": "integer",
          "minimum": 10,
          "default": 200
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 0,
          "default": 43200,
          "description": "Maximum pod runtime in seconds (12h default)."
        },
        "max_gpu_hours": {
          "type": "number",
          "minimum": 0,
          "description": "Hard cap on GPU hours for this run."
        },
        "max_runpod_spend_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Hard cap on estimated RunPod spend for this run."
        },
        "require_spend_confirmation": {
          "type": "boolean",
          "default": true,
          "description": "Headless runs must pre-confirm spend via config or CLI state."
        },
        "storage_name": {
          "type": "string",
          "description": "RunPod network storage volume name."
        },
        "image": {
          "type": "string",
          "default": "ostris/aitoolkit:latest",
          "description": "Docker image for the training pod."
        },
        "ports": {
          "type": "string",
          "default": "8675/http,22/tcp",
          "description": "Port mapping string for RunPod."
        }
      }
    },
    "base_model": {
      "type": "string",
      "description": "Base model identifier for training.",
      "default": "Lightricks/LTX-2.3/ltx-2.3-22b-dev.safetensors"
    },
    "lora_config": {
      "type": "object",
      "description": "LoRA-specific hyperparameters.",
      "additionalProperties": false,
      "properties": {
        "lora_id": {
          "type": "string",
          "description": "Identifier for this LoRA (used in output paths)."
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "default": 16
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "default": 2000
        },
        "learning_rate": {
          "type": "number",
          "minimum": 0,
          "default": 0.0001
        },
        "seed": {
          "type": "integer",
          "default": 42
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "description": "Checkpoint review configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "sample_prompts": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Prompts used to generate sample outputs at each checkpoint."
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["run_dir"],
      "additionalProperties": false,
      "properties": {
        "run_dir": {
          "type": "string",
          "description": "Output directory for this training run."
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Reserved extension object.",
      "additionalProperties": true
    }
  }
}
