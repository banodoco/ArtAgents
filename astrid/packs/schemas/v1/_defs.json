{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "_defs.json",
  "definitions": {
    "qualified_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version_string": {
      "type": "string"
    },
    "runtime_python_cli": {
      "type": "object",
      "required": ["type", "entrypoint"],
      "properties": {
        "type": {"type": "string", "const": "python-cli"},
        "entrypoint": {"type": "string"},
        "callable": {"type": "string"},
        "function": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runtime_python": {
      "type": "object",
      "description": "Runtime shape consumed by astrid.core.orchestrator.schema.RuntimeSpec for Python orchestrators.",
      "required": ["kind", "module", "function"],
      "properties": {
        "kind": {"type": "string", "const": "python"},
        "module": {"type": "string"},
        "function": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runtime_command": {
      "type": "object",
      "description": "Runtime shape consumed by astrid.core.orchestrator.schema.RuntimeSpec for command orchestrators.",
      "required": ["kind", "command"],
      "properties": {
        "kind": {"type": "string", "const": "command"},
        "command": {
          "type": "object",
          "required": ["argv"],
          "properties": {
            "argv": {
              "type": "array",
              "items": {"type": "string"}
            },
            "cwd": {"type": "string"},
            "env": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime_command_legacy": {
      "type": "object",
      "required": ["type", "command"],
      "properties": {
        "type": {"type": "string", "const": "command"},
        "command": {
          "type": "object",
          "required": ["argv"],
          "properties": {
            "argv": {
              "type": "array",
              "items": {"type": "string"}
            },
            "cwd": {"type": "string"},
            "env": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
