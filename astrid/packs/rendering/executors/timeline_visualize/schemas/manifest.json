{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrid.dev/schemas/timeline-visualize/v1/manifest.json",
  "title": "Astrid timeline visualization manifest v1",
  "description": "Universal result manifest plus immutable visualization-run identity and entrypoints.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "inputs",
    "outputs",
    "created",
    "warnings",
    "run_id",
    "run_root",
    "snapshots",
    "compositor",
    "scope",
    "layouts",
    "page_count",
    "reading_order",
    "entrypoints",
    "optional_formats",
    "companions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "timeline_visualize"},
    "inputs": {
      "type": "object",
      "required": ["timeline_source", "from_view", "focus", "scope", "layout", "formats"],
      "properties": {
        "timeline_source": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "from_view": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "focus": {
          "oneOf": [
            {"$ref": "_defs.json#/$defs/focus_ref"},
            {"type": "null"}
          ]
        },
        "scope": {"$ref": "_defs.json#/$defs/scope/properties/kind"},
        "layout": {"type": "string", "enum": ["time-scaled", "linear", "both"]},
        "formats": {
          "type": "array",
          "items": {"type": "string", "enum": ["png", "svg", "md"]},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"focus": {"not": {"type": "null"}}},
            "required": ["focus"]
          },
          "then": {"properties": {"from_view": {"type": "string", "minLength": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "_defs.json#/$defs/universal_output"},
      "minItems": 1
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "Operational wall-clock metadata; excluded from SNS identity."
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "run_id": {"$ref": "_defs.json#/$defs/ulid"},
    "run_root": {"type": "string", "minLength": 1},
    "snapshots": {"$ref": "_defs.json#/$defs/snapshot_set"},
    "compositor": {
      "type": "object",
      "required": ["package", "version", "source_snapshot_path", "registry_default_fingerprint"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_snapshot_path": {"type": "string", "minLength": 1},
        "registry_default_fingerprint": {"$ref": "_defs.json#/$defs/raw_sha256"}
      },
      "additionalProperties": false
    },
    "scope": {"$ref": "_defs.json#/$defs/scope"},
    "layouts": {
      "type": "array",
      "items": {"$ref": "_defs.json#/$defs/layout_kind"},
      "minItems": 1,
      "uniqueItems": true
    },
    "page_count": {"type": "integer", "minimum": 0},
    "reading_order": {
      "type": "array",
      "items": {"$ref": "_defs.json#/$defs/page_id"},
      "uniqueItems": true
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "manifest",
        "ground_truth",
        "view_map",
        "action_index",
        "asset_index",
        "transcript_index",
        "diagnostics",
        "reading_guide",
        "structure",
        "primary_image"
      ],
      "properties": {
        "manifest": {"$ref": "_defs.json#/$defs/artifact_path"},
        "ground_truth": {"$ref": "_defs.json#/$defs/artifact_path"},
        "view_map": {"$ref": "_defs.json#/$defs/artifact_path"},
        "action_index": {"$ref": "_defs.json#/$defs/artifact_path"},
        "asset_index": {"$ref": "_defs.json#/$defs/artifact_path"},
        "transcript_index": {"$ref": "_defs.json#/$defs/artifact_path"},
        "diagnostics": {"$ref": "_defs.json#/$defs/artifact_path"},
        "reading_guide": {"$ref": "_defs.json#/$defs/artifact_path"},
        "structure": {"$ref": "_defs.json#/$defs/nullable_artifact_path"},
        "primary_image": {"$ref": "_defs.json#/$defs/nullable_artifact_path"}
      },
      "additionalProperties": false
    },
    "optional_formats": {
      "type": "object",
      "required": ["png", "svg", "structure"],
      "properties": {
        "png": {"$ref": "_defs.json#/$defs/optional_entrypoint"},
        "svg": {"$ref": "_defs.json#/$defs/optional_entrypoint"},
        "structure": {"$ref": "_defs.json#/$defs/optional_entrypoint"}
      },
      "additionalProperties": false
    },
    "companions": {
      "type": "object",
      "required": ["reading_guide", "structure"],
      "properties": {
        "reading_guide": {
          "type": "object",
          "required": ["path", "content_kind", "schema"],
          "properties": {
            "path": {"$ref": "_defs.json#/$defs/artifact_path"},
            "content_kind": {"type": "string", "const": "prose"},
            "schema": {"type": "null"}
          },
          "additionalProperties": false
        },
        "structure": {
          "type": "object",
          "required": ["path", "reason", "content_kind", "breadcrumb", "suggested_next_actions"],
          "properties": {
            "path": {"$ref": "_defs.json#/$defs/nullable_artifact_path"},
            "reason": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"type": "null"}
              ]
            },
            "content_kind": {"type": "string", "const": "factual_markdown"},
            "breadcrumb": {
              "type": "array",
              "items": {"$ref": "_defs.json#/$defs/focus_ref"}
            },
            "suggested_next_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["object_ref", "action"],
                "properties": {
                  "object_ref": {"$ref": "_defs.json#/$defs/qualified_ref"},
                  "action": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"path": {"type": "null"}}, "required": ["path"]},
              "then": {"properties": {"reason": {"type": "string", "minLength": 1}}},
              "else": {"properties": {"reason": {"type": "null"}}}
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-bundle-constraints": [
    "snapshots are ordered by timeline display ordinal and byte-identical across every artifact",
    "page_count equals view-map.json pages length",
    "reading_order equals view-map.json reading_order",
    "companion and entrypoint paths resolve inside run_root"
  ]
}
