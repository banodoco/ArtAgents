{
  "schema_version": 1,
  "media_type": "video",
  "dataset_id": "fixture-smoke-test",
  "description": "Smoke-test dataset config for offline fixture validation.",
  "sources": [
    {
      "provider": "local_folder",
      "config": {
        "path": "fixtures/media/",
        "recursive": false,
        "extensions": [".mp4", ".mov"]
      }
    }
  ],
  "buckets": {
    "smoke_bucket": {
      "target_count": 2,
      "description": "Generic test bucket for fixture validation."
    }
  },
  "clip_config": {
    "min_duration_s": 2.0,
    "max_duration_s": 30.0,
    "max_scenes_per_source": 5
  },
  "caption": {
    "provider": "visual_understand",
    "prompt_template": "Describe this clip briefly.",
    "schema_path": "fixtures/schemas/caption.json"
  },
  "filters": {
    "duration": {
      "enabled": true,
      "min_s": 2.0,
      "max_s": 30.0
    },
    "resolution": {
      "enabled": true,
      "min_width": 64,
      "min_height": 64
    },
    "content_hash": {
      "enabled": true
    }
  },
  "review": {
    "enabled": true,
    "sampling": {
      "mode": "all"
    },
    "reject_reasons": ["watermark", "wrong_scene", "low_quality", "other"]
  },
  "manifest": {
    "adapter": "ai-toolkit-ltx"
  },
  "budgets": {
    "max_api_calls": 10,
    "max_estimated_cost_usd": 0.50,
    "providers": {}
  },
  "output": {
    "run_dir": "runs/fixture-smoke-test"
  }
}
