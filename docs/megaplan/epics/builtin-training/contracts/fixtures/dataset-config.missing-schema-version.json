{
  "media_type": "video",
  "dataset_id": "legacy-no-version",
  "description": "Legacy config without schema_version. Parser should warn and treat as v1.",
  "sources": [
    {
      "provider": "youtube",
      "config": {
        "search_queries": ["test query"]
      }
    }
  ],
  "buckets": {
    "test_bucket": {
      "target_count": 1
    }
  },
  "caption": {
    "provider": "visual_understand"
  },
  "manifest": {
    "adapter": "ai-toolkit-ltx"
  },
  "output": {
    "run_dir": "runs/legacy-test"
  }
}
