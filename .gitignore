# Secrets and local environment
.env
.env.*
this.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*
*secret*
# Real source files whose names trip the broad credential globs above.
!astrid/core/util/secrets.py

# Python
__pycache__/
.venv/
venv/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Remotion
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
remotion/build/
remotion/out/

# Generated runtime artifacts
runs/
cache/
.astrid/
**/.cas/
*/cache/
*/out/
*.log
*.mp4
*.mov
*.wav
*.jpg
*.jpeg
*.png

# Agentic test artifacts (regenerated per-run, not source)
tests/agentic/reports/
tests/agentic/__pycache__/

# Local workspace/tool state
.DS_Store
.tmp/
.claude/
.megaplan/
.compactify/
.megaplan-worktrees/

# Local scratch pack (gitignored)
/astrid/packs/local/

# Generated orchestrator build artifacts (compiled DSL JSON)
astrid/packs/*/build/

# Megaplan working state
plan_revision.json

# Astrid file-bound session pointer (T9 / FLAG-S1-003)
.astrid-session

