{
  "target_strict_score": 95,
  "review_max_age_days": 30,
  "review_batch_max_files": 80,
  "holistic_max_age_days": 30,
  "generate_scorecard": true,
  "badge_path": "scorecard.png",
  "exclude": [
    ".claude",
    ".megaplan",
    ".megaplan-worktrees",
    ".compactify",
    ".pytest_cache",
    ".venv",
    "__pycache__",
    "node_modules",
    ".astrid",
    "astrid/packs/seinfeld/ai_toolkit/upstream",
    "astrid/packs/builtin/html_canvas_effect/templates",
    "examples",
    "avatars",
    "docs",
    "agents"
  ],
  "ignore": [],
  "ignore_metadata": {},
  "zone_overrides": {
    "remotion/remotion.config.ts": "config",
    "remotion/src/types.generated.ts": "generated",
    "remotion/src/fonts.ts": "config",
    "remotion/src/Root.tsx": "config",
    "remotion/src/index.ts": "config",
    "scripts/codemod-theme-api-imports.ts": "script",
    "astrid/packs/local/elements/effects/text-card/component.tsx": "config",
    "astrid/packs/local/elements/effects/model-trends/component.tsx": "config",
    "astrid/packs/local/elements/effects/neon-orbit-card/component.tsx": "config",
    "astrid/packs/local/elements/effects/_shared/clip-effects.ts": "config"
  },
  "review_dimensions": [],
  "large_files_threshold": 0,
  "props_threshold": 0,
  "issue_noise_budget": 10,
  "issue_noise_global_budget": 0,
  "execution_log_max_entries": 10000,
  "needs_rescan": false,
  "languages": {},
  "commit_tracking_enabled": true,
  "commit_pr": 0,
  "commit_default_branch": "",
  "commit_message_template": "desloppify: {status} {count} issue(s) \u2014 {summary}",
  "trust_plugins": false,
  "transition_messages": {}
}
