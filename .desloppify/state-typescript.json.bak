    "review::.::holistic::error_consistency::best_effort_metadata_swallow_cluster": {
      "id": "review::.::holistic::error_consistency::best_effort_metadata_swallow_cluster",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Several best-effort metadata readers silently degrade to empty containers on any exception, with no logging or narrowing.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "astrid/skills/discovery.py",
          "astrid/skills/__init__.py",
          "astrid/skills/harnesses/base.py",
          "astrid/threads/provenance.py",
          "astrid/threads/attribute.py",
          "astrid/packs/iteration/prepare/run.py"
        ],
        "evidence": [
          "skills/discovery.py:55-60 wraps `yaml.safe_load` in `except Exception: data = {}` \u2014 a malformed YAML frontmatter is silently dropped instead of warning the author.",
          "skills/__init__.py:239-242 wraps adapter.discover_installed in `except Exception: fs_record = None` \u2014 drift detection silently treats any adapter failure as 'not installed'.",
          "skills/harnesses/base.py:71-74 wraps verify() in `except Exception: return None` \u2014 a verify regression looks identical to 'not installed'.",
          "threads/provenance.py:138-145 returns 'Unknown thread' on any ThreadIndexStore failure.",
          "packs/iteration/prepare/run.py:460-466 and 469-481 each silently return empty set/dict when ThreadIndexStore or selection_history raises.",
          "threads/attribute.py:289-292 swallows write_run_record exceptions inside an orphan-reaper loop with `continue` \u2014 orphans silently fail to be marked, and the loop reports a misleadingly low count."
        ],
        "suggestion": "Adopt a single 'best-effort read' helper that catches narrow IO/parse errors (OSError, json.JSONDecodeError, yaml.YAMLError, KeyError) and logs a debug line including the file path and exception. Apply it everywhere this pattern repeats; let unexpected errors (TypeError/AttributeError) propagate so they get noticed.",
