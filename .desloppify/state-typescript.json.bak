    "review::.::holistic::error_consistency::metadata_readers_silent_degrade": {
      "id": "review::.::holistic::error_consistency::metadata_readers_silent_degrade",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Six best-effort metadata readers each silently degrade to empty containers on any exception, with no logging or narrowing.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "astrid/skills/discovery.py",
          "astrid/skills/__init__.py",
          "astrid/skills/harnesses/base.py",
          "astrid/threads/provenance.py",
          "astrid/threads/attribute.py",
          "astrid/packs/iteration/prepare/run.py"
        ],
        "evidence": [
          "astrid/skills/discovery.py:59 catches bare Exception when parsing YAML frontmatter and returns `{}` \u2014 a malformed SKILL.md silently disappears from the discovery list.",
          "astrid/skills/__init__.py:241 catches bare Exception around `adapter.discover_installed(descriptor)` and treats every adapter failure as 'not installed'.",
          "astrid/skills/harnesses/base.py:73 catches bare Exception around the `verify` call and returns None, conflating 'not installed' with 'verify itself crashed'.",
          "astrid/threads/provenance.py:141 catches bare Exception around `ThreadIndexStore(repo_root).read()` and returns the literal string 'Unknown thread'.",
          "astrid/threads/attribute.py:291 catches bare Exception around `write_run_record(updated, run_json)` and increments nothing \u2014 a write failure during reaper sweep is invisible.",
          "astrid/packs/iteration/prepare/run.py:463,475 catch bare Exception around ThreadIndexStore.read() and selection_history() respectively, returning empty set/dict in either case.",
