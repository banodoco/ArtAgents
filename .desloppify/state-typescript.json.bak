      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Pack effect components type clip and params as `any`, then defensively re-narrow with `as` casts and ?? fallbacks across both prop sources",
      "detail": {
        "holistic": true,
        "dimension": "ai_generated_debt",
        "related_files": [
