      "id": "review::.::holistic::contract_coherence::die_helpers_noreturn_annotation_lie",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "_die / usage_error helpers across 7 builtin pack modules are annotated `-> None` but always raise SystemExit (should be NoReturn)",
      "detail": {
        "holistic": true,
