      "id": "review::.::holistic::naming_quality::underscore_prefix_on_used_normalizer",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "`_normalizeEffects` uses TS leading-underscore (signals 'unused/ignored') but is actively called in the same file",
      "detail": {
        "holistic": true,
        "dimension": "naming_quality",
        "related_files": [
          "astrid/packs/local/elements/effects/model-trends/component.tsx",
          "astrid/packs/local/elements/effects/text-card/component.tsx"
        ],
        "evidence": [
          "model-trends/component.tsx:44 defines `const _normalizeEffects = (effects: unknown): Effects => {...}` and calls it at line 430 (`const effects = _normalizeEffects(clip.effects)`).",
          "text-card/component.tsx:121 defines `const _normalizeEffects` and calls it at line 259.",
