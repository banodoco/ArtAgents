{
  "schema_version": 1,
  "media_type": "video",
  "dataset_id": "builtin-training-fixture",
  "description": "Offline fixture config for builtin.dataset_build.",
  "sources": [
    {
      "provider": "local_folder",
      "config": {
        "path": "media",
        "extensions": [".mp4"],
        "source_id_template": "fixture_{stem}",
        "rights": {
          "license": "fixture",
          "attribution": "Astrid fixture media",
          "restrictions": [],
          "rights_status": "verified"
        }
      }
    }
  ],
  "buckets": {
    "establishing": {
      "target_count": 2,
      "description": "Simple generic establishing clips for no-network tests.",
      "search_queries": ["fixture establishing clip"]
    }
  },
  "clip_config": {
    "min_duration_s": 1.0,
    "max_duration_s": 5.0,
    "max_scenes_per_source": 3
  },
  "caption": {
    "provider": "visual_understand",
    "prompt_template": "Describe fixture clip {clip_id} for a training dataset."
  },
  "filters": {
    "duration": {
      "enabled": true,
      "min_s": 1.0,
      "max_s": 5.0
    }
  },
  "review": {
    "enabled": true,
    "reject_reasons": ["watermark", "wrong_scene", "wrong_character", "bad_motion", "low_quality", "wrong_content", "rights_concern", "other"]
  },
  "manifest": {
    "adapter": "ai-toolkit-ltx"
  },
  "budgets": {
    "max_api_calls": 0,
    "max_estimated_cost_usd": 0,
    "providers": {
      "caption.visual_understand": {
        "max_calls": 0
      },
      "bucket_judge.visual_understand": {
        "max_calls": 0
      }
    }
  },
  "output": {
    "run_dir": "ignored-by-cli"
  },
  "extensions": {
    "fixture_mode": true,
    "fixture_caption_dir": "captions",
    "fixture_judge_dir": "judges",
    "bucket_judge": {
      "enabled": true,
      "mode": "fixture",
      "provider": "visual_understand",
      "prompt_template": "Classify {clip_id} into one of: {buckets}.",
      "buckets": ["establishing"]
    }
  }
}
