{
  "schema_version": 1,
  "media_type": "video",
  "dataset_id": "builtin-training-cheap-filter-fixture",
  "description": "Offline ordered cheap-filter fixture config for builtin.dataset_build.",
  "sources": [
    {
      "provider": "local_folder",
      "config": {
        "path": "media",
        "extensions": [".mp4"]
      }
    }
  ],
  "buckets": {
    "establishing": {
      "target_count": 2,
      "description": "Ordered cheap-filter fixture clips."
    }
  },
  "clip_config": {
    "min_duration_s": 1.0,
    "max_duration_s": 5.0,
    "max_scenes_per_source": 1
  },
  "caption": {
    "provider": "visual_understand",
    "prompt_template": "Describe cheap-filter fixture clip {clip_id}."
  },
  "filters": {
    "stages": [
      {
        "stage_id": "duration_filter",
        "config": {
          "min_s": 1.0,
          "max_s": 5.0
        }
      },
      {
        "stage_id": "rights_filter"
      },
      {
        "stage_id": "black_frame_filter",
        "config": {
          "max_black_frame_ratio": 0.98
        }
      },
      {
        "stage_id": "content_hash_filter"
      },
      {
        "stage_id": "source_cap_filter",
        "config": {
          "max_per_source": 1
        }
      }
    ]
  },
  "review": {
    "enabled": true,
    "sampling": {
      "mode": "top_n",
      "sample_count": 1
    },
    "reject_reasons": ["watermark", "wrong_scene", "wrong_character", "bad_motion", "low_quality", "wrong_content", "rights_concern", "other"]
  },
  "manifest": {
    "adapter": "ai-toolkit-ltx"
  },
  "budgets": {
    "max_api_calls": 0,
    "max_estimated_cost_usd": 0,
    "providers": {
      "caption.visual_understand": {
        "max_calls": 0
      }
    }
  },
  "output": {
    "run_dir": "ignored-by-cli"
  },
  "extensions": {
    "fixture_mode": true
  }
}
